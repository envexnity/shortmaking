# Copy to .env.postiz before running docker compose
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=postiz-pass

# YouTube (Google Cloud Console -> OAuth Client ID)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok (TikTok for Developers -> Client Key & Secret)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Instagram / Facebook (Meta for Developers -> App ID & Secret)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
