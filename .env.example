# Copy this file to .env and fill in the platforms you want to auto-publish to.
# YouTube uses client_secrets.json in the workspace root (c:\Users\AFADAZIO\OneDrive\Desktop\shortmaking\client_secrets.json).

# --- TikTok Content Posting API v2 ---
TIKTOK_ACCESS_TOKEN=

# --- Instagram Graph API v21.0 (Reels) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Cloudflare R2 (Temp HTTPS staging URL so Instagram can fetch the MP4) ---
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
